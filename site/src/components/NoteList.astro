---
import { formatDate, noteHref, type Note } from '../lib/notes';
interface Props {
  notes: Note[];
  showTopics?: boolean;
}
const { notes, showTopics = false } = Astro.props;
---
<ul class="notes">
  {notes.map((n) => (
    <li>
      <span class="muted">{formatDate(n.data.date)}</span> — <a href={noteHref(n.id)}>{n.data.title}</a>
      {n.data.status !== 'active' && <span class="muted">（{n.data.status}）</span>} — {n.data.question}
      {showTopics && (
        <div>
          {n.data.topics.map((t) => <a class="tag" href={`/topics/${t}/`}>{t}</a>)}
        </div>
      )}
    </li>
  ))}
</ul>
