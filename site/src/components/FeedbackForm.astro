---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import { MAX_BODY_CHARS, MAX_LOCATION_CHARS, UNAVAILABLE_MESSAGE } from '../lib/feedback.ts';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const siteKey = PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<section class="feedback" aria-labelledby="feedback-title">
  <h2 id="feedback-title">このノートへのフィードバック</h2>
  <p class="muted">誤り・補足・出典の指摘などを匿名で送れます。GitHub アカウントは不要です。送った内容は公開されません。</p>
  <form id="feedback-form" method="post" action="/api/feedback" data-site-key={siteKey} novalidate>
    <input type="hidden" name="slug" value={slug} />
    <input type="hidden" name="submission_id" value="" />
    <div class="hp" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <label for="feedback-location">該当箇所（任意）</label>
    <input id="feedback-location" type="text" name="location" maxlength={MAX_LOCATION_CHARS} placeholder="例：根拠の表の2行目" />
    <label for="feedback-body">本文（必須、{MAX_BODY_CHARS.toLocaleString('en-US')} 字まで）</label>
    <textarea id="feedback-body" name="body" rows="6" maxlength={MAX_BODY_CHARS} required></textarea>
    {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-action="feedback"></div>}
    <button type="submit" disabled={!siteKey}>送信</button>
    <p class="feedback-result" role="status" aria-live="polite">{!siteKey && UNAVAILABLE_MESSAGE}</p>
  </form>
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</section>

<script>
  const UNAVAILABLE = '現在送信できません';
  const form = document.getElementById('feedback-form') as HTMLFormElement | null;
  if (form && form.dataset.siteKey) {
    const result = form.querySelector('.feedback-result') as HTMLElement;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const idInput = form.elements.namedItem('submission_id') as HTMLInputElement;
    const bodyInput = form.elements.namedItem('body') as HTMLTextAreaElement;
    const locationInput = form.elements.namedItem('location') as HTMLInputElement;
    // 送信ごとの一意 ID。通信失敗の再送では同じ ID を使い、成功したら作り直す
    const newId = () => (idInput.value = crypto.randomUUID());
    newId();

    const show = (msg: string, ok: boolean) => {
      result.textContent = msg;
      result.dataset.state = ok ? 'ok' : 'error';
    };

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!bodyInput.value.trim()) {
        show('本文を入力してください', false);
        bodyInput.focus();
        return;
      }
      button.disabled = true;
      show('送信中…', true);
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = (await res.json().catch(() => null)) as { ok?: boolean; message?: string } | null;
        if (res.ok && data?.ok) {
          show(data.message ?? '送信しました', true);
          bodyInput.value = '';
          locationInput.value = '';
          newId();
        } else {
          show(data?.message ?? (res.status === 503 ? UNAVAILABLE : `送信に失敗しました（${res.status}）`), false);
        }
      } catch {
        show('通信に失敗しました。もう一度お試しください', false);
      } finally {
        (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .feedback { margin-top: 3rem; padding: 1rem 1.25rem; border: 1px solid var(--line); border-radius: 8px; background: var(--soft); }
  .feedback h2 { margin-top: 0; font-size: 1.15rem; }
  form { display: grid; gap: 0.4rem; }
  label { font-weight: 600; font-size: 0.95em; margin-top: 0.5rem; }
  input[type='text'], textarea { width: 100%; font: inherit; padding: 0.4rem 0.5rem; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: inherit; }
  button { justify-self: start; margin-top: 0.5rem; padding: 0.4rem 1.25rem; font: inherit; cursor: pointer; }
  button:disabled { cursor: not-allowed; opacity: 0.6; }
  .feedback-result { margin: 0.25rem 0 0; min-height: 1.75em; }
  .feedback-result[data-state='error'] { color: #cf222e; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
</style>
