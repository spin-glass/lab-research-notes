---
interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const siteName = 'lab-research-notes';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${siteName}` : siteName}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">{siteName}</a>
      <nav>
        <a href="/">一覧</a>
        <a href="/topics/">トピック</a>
        <a href="https://github.com/spin-glass/lab-research-notes">GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --fg: #1f2328;
    --muted: #59636e;
    --bg: #ffffff;
    --line: #d1d9e0;
    --soft: #f6f8fa;
    --link: #0969da;
    --warn-bg: #fff8c5;
    --warn-line: #d4a72c;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fg: #e6edf3;
      --muted: #9198a1;
      --bg: #0d1117;
      --line: #3d444d;
      --soft: #151b23;
      --link: #4493f8;
      --warn-bg: #2e2a1a;
      --warn-line: #9e6a03;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, 'Hiragino Sans', 'Noto Sans JP', sans-serif;
    line-height: 1.75;
  }
  a { color: var(--link); }
  main { max-width: 52rem; margin: 0 auto; padding: 1rem 1rem 4rem; }
  .site-header {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; align-items: baseline; justify-content: space-between;
    max-width: 52rem; margin: 0 auto; padding: 1rem; border-bottom: 1px solid var(--line);
  }
  .site-header .brand { font-weight: 700; color: inherit; text-decoration: none; }
  .site-header nav { display: flex; gap: 1rem; }
  .muted { color: var(--muted); }
  .tag { display: inline-block; padding: 0 0.5rem; margin: 0 0.25rem 0.25rem 0; border: 1px solid var(--line); border-radius: 1rem; font-size: 0.85em; text-decoration: none; }
  ul.notes { padding-left: 1.2rem; }
  ul.notes li { margin: 0.4rem 0; }
  .prose table { border-collapse: collapse; display: block; overflow-x: auto; margin: 1rem 0; font-size: 0.92em; }
  .prose th, .prose td { border: 1px solid var(--line); padding: 0.35rem 0.6rem; vertical-align: top; min-width: 7em; }
  .prose th { background: var(--soft); }
  .prose a { overflow-wrap: anywhere; }
  .prose code { background: var(--soft); padding: 0.1em 0.3em; border-radius: 4px; }
  .prose pre { background: var(--soft); padding: 0.75rem; overflow-x: auto; }
  .prose pre code { background: none; padding: 0; }
</style>
